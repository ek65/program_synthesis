   "source": [
    "import sys, os\n",
    "\n",
    "dir = os.path.abspath('..')\n",
    "sys.path.append(os.path.join(dir))\n",
    "while not os.path.basename(dir) == 'v2':\n",
    "    parent = os.path.dirname(dir)\n",
    "    if parent == dir:\n",
    "        raise FileNotFoundError(\"No parent directory named 'v2' found.\")\n",
    "    dir = parent"
   ]
  }
